    {
      "type": "table",
      "title": "Contexto de la corrida",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.ingest_date::text AS \"Ingesta\", r.snapshot_date::text AS \"Snapshot\", r.window_days AS \"Ventana (días)\", r.model_version AS \"Champion\", b.ingest_date::text AS \"Benchmark (ingesta)\", r.git_commit AS \"Commit\", to_char(r.created_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI') || ' UTC' AS \"Ejecutada\" FROM runs r LEFT JOIN runs b ON b.run_id=(SELECT max(run_id) FROM runs WHERE dataset='benchmark' AND model_version=(SELECT model_version FROM runs WHERE run_id=$run)) WHERE r.run_id=$run"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": []
