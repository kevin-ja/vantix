      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.run_id AS \"Run\", r.dataset AS \"Tipo\", r.model_version AS \"Champion\", r.ingest_date::text AS \"Ingesta\", r.snapshot_date::text AS \"Snapshot\", r.n_rows AS \"Transacciones\", r.n_users AS \"Usuarios\", (SELECT count(*) FROM data_quality q WHERE q.run_id=r.run_id AND q.alert AND r.dataset='new') AS \"Alertas DQ\", (SELECT count(*) FROM data_drift d WHERE d.run_id=r.run_id AND d.alert) AS \"Alertas drift\", to_char(r.created_at AT TIME ZONE 'UTC','YYYY-MM-DD HH24:MI') || ' UTC' AS \"Ejecutada\" FROM runs r ORDER BY r.run_id DESC"
