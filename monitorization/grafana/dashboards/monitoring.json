    {
      "type": "table",
      "title": "Data Drift por dimensión RFM",
      "description": "Alerta desde cambio moderado: PSI ≥ 0.1 o KS ≥ 0.05.",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT feature AS \"Dimensión\", round(psi::numeric,4) AS \"PSI\", psi_level AS \"Nivel PSI\", round(ks::numeric,4) AS \"KS\", ks_level AS \"Nivel KS\", CASE WHEN alert THEN 'ALERTA' ELSE 'OK' END AS \"Estado\" FROM data_drift WHERE run_id=$run ORDER BY array_position(ARRAY['Recency','Frequency','Monetary','Profit_30d','Avg_Odds'], feature)"
        }
      ],
      "options": {
        "showHeader": true
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ALERTA": {
                        "color": "red",
                        "index": 0
                      },
                      "OK": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
