    {
      "type": "barchart",
      "title": "PSI por corrida",
      "description": "Línea naranja: alerta (0.1). Roja: cambio significativo (0.25).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT r.ingest_date::text AS \"Corrida\", max(psi) FILTER (WHERE feature='Recency') AS \"Recency\", max(psi) FILTER (WHERE feature='Frequency') AS \"Frequency\", max(psi) FILTER (WHERE feature='Monetary') AS \"Monetary\", max(psi) FILTER (WHERE feature='Profit_30d') AS \"Profit_30d\", max(psi) FILTER (WHERE feature='Avg_Odds') AS \"Avg_Odds\" FROM data_drift d JOIN runs r USING (run_id) WHERE r.dataset='new' GROUP BY r.run_id, r.ingest_date ORDER BY r.run_id"
        }
      ],
      "options": {
        "xField": "Corrida",
