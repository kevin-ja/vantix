    {
      "type": "row",
      "title": "Data Quality (doc §3.1, umbrales §5.3)",
      "collapsed": false,
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 24,
        "h": 1
      },
      "panels": []
    },
    {
      "type": "table",
      "title": "Data Quality: corrida vs. benchmark",
      "description": "Nulos, inválidos, consistencia y completitud: > 0 → alerta. Duplicados: alerta desde moderado (≥ 0,5 %).",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "monitoring-pg"
          },
          "format": "table",
          "rawQuery": true,
          "editorMode": "code",
          "rawSql": "SELECT CASE q.metric WHEN 'nulls' THEN 'Nulos' WHEN 'duplicates' THEN 'Duplicados' WHEN 'invalid' THEN 'Valores inválidos' WHEN 'consistency' THEN 'Consistencia' WHEN 'completeness' THEN 'Completitud' END AS \"Métrica\", round(b.value::numeric,4) AS \"Benchmark\", round(q.value::numeric,4) AS \"Corrida\", q.unit AS \"Unidad\", q.level AS \"Nivel\", CASE WHEN q.alert THEN 'ALERTA' ELSE 'OK' END AS \"Estado\", q.details::text AS \"Detalle\" FROM data_quality q LEFT JOIN data_quality b ON b.metric=q.metric AND b.run_id=(SELECT max(run_id) FROM runs WHERE dataset='benchmark' AND model_version=(SELECT model_version FROM runs WHERE run_id=$run)) WHERE q.run_id=$run ORDER BY array_position(ARRAY['nulls','duplicates','invalid','consistency','completeness'], q.metric)"
        }
      ],
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      },
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "Estado"
            },
            "properties": [
              {
                "id": "mappings",
                "value": [
                  {
                    "type": "value",
                    "options": {
                      "ALERTA": {
                        "color": "red",
                        "index": 0
                      },
                      "OK": {
                        "color": "green",
                        "index": 1
                      }
                    }
                  }
                ]
              },
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background",
                  "mode": "basic"
                }
              }
            ]
          },
          {
            "matcher": {
              "id": "byName",
              "options": "Detalle"
            },
            "properties": [
              {
                "id": "custom.width",
                "value": 520
              }
            ]
          }
        ]
      },
      "gridPos": {
        "x": 0,
        "y": 9,
        "w": 24,
        "h": 7
      },
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "monitoring-pg"
