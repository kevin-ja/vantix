# Configuración del setup (make train-up, inference-up, monitoring-up).
#   cp .env.example .env     y completa lo que está entre <>
#
# Ningún dato es secreto: aquí NO van contraseñas, llaves ni tokens. Los inicios de sesión ocurren en el navegador.

# AWS (IAM Identity Center)
SSO_START_URL=<https://tu-portal.awsapps.com/start>
SSO_REGION=us-east-1
ACCOUNT_ID=<12 dígitos>
ROLE_NAME=AdministratorAccess
PROFILE=vantix

# GitHub
GITHUB_REPO=<usuario/repo>

# Datos: etiqueta del lote que se sube
INGEST_DATE=2025-04-30

# Monitoreo: correo que recibe las alertas
ALERT_EMAIL=<correo>
