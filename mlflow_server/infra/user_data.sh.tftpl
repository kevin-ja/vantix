#!/bin/bash
# Arranque de la EC2 (cloud-init, una vez por instancia). Es el único script del servidor: lo ejecuta la máquina,
# no una persona. Todo lo variable viene de Terraform; nada se descarga sin versión fija.
set -euxo pipefail

# 1. Docker (versión fijada por la AMI: AL2023 bloquea los repos a su release) + Compose (versión + sha256)
dnf install -y docker
plugins=/usr/local/lib/docker/cli-plugins
mkdir -p "$plugins"
curl -fsSL -o "$plugins/docker-compose" \
  "https://github.com/docker/compose/releases/download/${compose_version}/docker-compose-linux-x86_64"
echo "${compose_sha256}  $plugins/docker-compose" | sha256sum -c -
chmod +x "$plugins/docker-compose"
systemctl enable --now docker

# 2. Archivos del servidor (los mismos del repo) + variables. Los secretos vienen de SSM, no de user_data.
mkdir -p /opt/mlflow
echo "${compose_b64}" | base64 -d > /opt/mlflow/compose.yml
echo "${litestream_b64}" | base64 -d > /opt/mlflow/litestream.yml
secret() { aws ssm get-parameter --region "${region}" --name "$1" --with-decryption --query Parameter.Value --output text; }
password=$(secret "${password_param}")
secret_key=$(secret "${secret_key_param}")
umask 077
cat > /opt/mlflow/.env <<EOF
MLFLOW_IMAGE=${image_uri}
MLFLOW_BUCKET=${bucket}
MLFLOW_ARTIFACTS_PREFIX=${artifacts_prefix}
MLFLOW_REGISTRY_PREFIX=${registry_prefix}
MLFLOW_ALLOWED_HOSTS=${allowed_host},localhost*,127.0.0.1*
AWS_REGION=${region}
MLFLOW_AUTH_ADMIN_PASSWORD=$password
MLFLOW_FLASK_SERVER_SECRET_KEY=$secret_key
EOF
umask 022

# 3. Servicio systemd: en cada arranque (también tras stop/start) hace login en ECR y levanta compose.
cat > /etc/systemd/system/mlflow.service <<EOF
[Unit]
Description=MLflow tracking server (compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/mlflow
ExecStartPre=/bin/sh -c 'aws ecr get-login-password --region ${region} | docker login --username AWS --password-stdin ${ecr_registry}'
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose stop
TimeoutStartSec=900
Restart=on-failure
RestartSec=30

[Install]
WantedBy=multi-user.target
EOF
systemctl daemon-reload
systemctl enable --now mlflow.service
