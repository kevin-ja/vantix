# Variables que lee compose.yml. Las escribe el arranque de la EC2 en /opt/mlflow/.env (permiso 600);
# la contraseña sale de SSM Parameter Store. Las credenciales de AWS son las del rol de la EC2.
MLFLOW_IMAGE=<cuenta>.dkr.ecr.<región>.amazonaws.com/<repo>:<tag>
MLFLOW_BUCKET=<bucket>                    # artefactos y réplicas de las bases
MLFLOW_ARTIFACTS_PREFIX=artifacts
MLFLOW_REGISTRY_PREFIX=registry
MLFLOW_ALLOWED_HOSTS=<host-del-origen>,localhost*,127.0.0.1*
AWS_REGION=us-east-1
MLFLOW_AUTH_ADMIN_PASSWORD=<secreto>     # solo se usa la primera vez (base de usuarios vacía)
